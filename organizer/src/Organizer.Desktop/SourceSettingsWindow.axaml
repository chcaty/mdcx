<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Organizer.Desktop.ViewModels" x:Class="Organizer.Desktop.SourceSettingsWindow"
        x:DataType="vm:SourceSettingsViewModel" Title="元数据来源设置" Width="600" Height="635"
        MinWidth="460" MinHeight="450" WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="18">
    <StackPanel Spacing="5"><TextBlock Text="元数据来源" Classes="section" /><TextBlock Text="演示或真实来源，由您明确选择。" Classes="caption" /></StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="SourceSettingsScroller" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="14" Margin="0,0,10,0">
        <ComboBox x:Name="SourceModePicker" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="演示或真实来源模式" />
        <Border Classes="panel" Padding="14"><StackPanel Spacing="7">
          <TextBlock Text="JavBus · 番号资料" FontWeight="SemiBold" /><TextBlock Text="https://www.javbus.com" Classes="caption" />
          <TextBlock Text="保存后，仅在点击“检索当前文件”或“识别所选”时发送查询内容。配置、启动和扫描均不会自动查询。" Classes="caption" TextWrapping="Wrap" />
          <TextBlock x:Name="LiveVerificationNote" Text="尚未在线验收；可用性取决于来源响应。" Classes="tiny" TextWrapping="Wrap" />
        </StackPanel></Border>
        <StackPanel Spacing="6" IsEnabled="{Binding IsReal}">
          <TextBlock Text="代理地址（可选，不含账号密码）" FontWeight="SemiBold" />
          <TextBox x:Name="ProxyEditor" Text="{Binding Proxy}" Watermark="http://127.0.0.1:7890" AutomationProperties.Name="无凭据代理地址" />
          <TextBlock Text="留空则直连。仅接受 HTTP/HTTPS 与明确端口；不保存密码、令牌或 Cookie。设置代理后，请求流量也会经过该代理。" Classes="tiny" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="5" Margin="0,8,0,0">
            <TextBlock Text="连接超时 / 秒" Classes="caption" /><TextBlock Grid.Column="1" Text="单次请求超时 / 秒" Classes="caption" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="最小间隔 / 秒" Classes="caption" />
            <TextBox Grid.Row="1" Text="{Binding ConnectTimeout}" AutomationProperties.Name="连接超时秒数" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RequestTimeout}" AutomationProperties.Name="单次请求超时秒数" /><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Interval}" AutomationProperties.Name="最小请求间隔秒数" />
          </Grid>
          <TextBlock Text="整次查询上限为 25 秒，包含等待和重试。" Classes="tiny" TextWrapping="Wrap" />
          <TextBlock Text="各项范围 0.1–60 秒，单次超时设置不会延长整次查询上限。" Classes="tiny" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="配置保存在应用本地数据目录，卸载保留。清除配置会关闭真实来源并恢复演示。" Classes="tiny" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#845935" TextWrapping="Wrap" AutomationProperties.Name="来源配置错误" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="10">
      <Button x:Name="ResetSourceSettingsButton" Classes="flat" Content="清除配置并恢复演示" Click="ResetSettings" HorizontalAlignment="Left" />
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Button x:Name="CancelSourceSettingsButton" Content="取消" Click="CancelSettings" /><Button Grid.Column="2" x:Name="SaveSourceSettingsButton" Classes="primary" Content="{Binding SaveLabel}" Click="SaveSettings" /></Grid>
    </StackPanel>
  </Grid>
</Window>

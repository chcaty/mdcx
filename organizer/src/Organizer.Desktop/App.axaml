<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Organizer.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Noto Sans CJK SC, Microsoft YaHei UI, PingFang SC, sans-serif" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#929CA9" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#929CA9" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="5" /><Setter Property="MinHeight" Value="31" /><Setter Property="Padding" Value="11,5" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#608DDE" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="#39414E" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="4" /><Setter Property="MinHeight" Value="32" /><Setter Property="Background" Value="#161A21" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#1C212A" /><Setter Property="BorderBrush" Value="#303844" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="#171C24" /><Setter Property="BorderThickness" Value="0" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#252D38" /><Setter Property="RowHeight" Value="40" /></Style>
    <Style Selector="DataGridRow:nth-child(2n)"><Setter Property="Background" Value="#1A2029" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="12,7" /></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="#202733" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="9,8" /><Setter Property="MinHeight" Value="34" /></Style>
  </Application.Styles>
</Application>

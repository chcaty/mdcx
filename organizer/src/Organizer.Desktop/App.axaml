<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Organizer.Desktop.Controls"
             x:Class="Organizer.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush">#F8F9F6</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBrush">#EDF1E9</SolidColorBrush>
    <SolidColorBrush x:Key="InkBrush">#283D30</SolidColorBrush>
    <SolidColorBrush x:Key="BodyBrush">#4D604E</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#5E6B58</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#34583E</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#DFE5D9</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeAccentBrush">#34583E</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeAccentBrush2">#4D7250</SolidColorBrush>
    <SolidColorBrush x:Key="ThemeAccentBrush3">#6C875E</SolidColorBrush>
    <Color x:Key="SystemAccentColor">#34583E</Color>
    <x:Double x:Key="FontTiny">11.5</x:Double>
    <x:Double x:Key="FontSmall">12</x:Double>
    <x:Double x:Key="FontBody">13</x:Double>
    <x:Double x:Key="FontMedium">14</x:Double>
    <x:Double x:Key="FontTitle">16</x:Double>
    <x:Double x:Key="FontSection">18</x:Double>
    <x:Double x:Key="FontHero">20</x:Double>
    <x:Double x:Key="FontPage">26</x:Double>
    <local:PathLeafConverter x:Key="PathLeaf" />
    <local:StatusBrushConverter x:Key="StatusFill" />
    <local:StatusBrushConverter x:Key="StatusInk" Foreground="True" />
    <local:NonemptyConverter x:Key="Nonempty" />
    <local:ScanWarningVisibleConverter x:Key="HasWarning" />
    <local:IsZeroConverter x:Key="IsZero" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Organizer.Desktop/Themes/Workbench.axaml" />
  </Application.Styles>
</Application>
